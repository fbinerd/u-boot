CONFIG_MIPS=y
# This value was briefly changed to a DDR copy-test slot (0x81c10000) while
# tracking down a DMCR/MCR register-mapping bug in the GPL DDR calibration
# (arch/mips/mach-rtl-otto/preloader/sg1002_mr_gpl_cali.c) that made the
# Stage-1 full-copy check fail; once that bug was fixed, testing measured
# zero copy errors across every tap and lane scanned, and this reverted to
# CONFIG_TEXT_BASE's original value, matching the linked _start
# (System.map: 83f01000 T _start) and this project's own bring-up diary
# (doc/board/intelbras-sg1002-mr-bringup.md). This is also what every build
# actually used in practice, even before it was saved back to this file.
CONFIG_TEXT_BASE=0x83f01000
CONFIG_SYS_MALLOC_LEN=0x20000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
# Initial stack in the SoC's internal SRAM, above the 32 KiB the Stage-1
# preloader itself uses (arch/mips/mach-rtl-otto/preloader/sg1002_mr.lds).
# Moving it to the board's default DRAM CFG_SYS_INIT_SP_ADDR instead was
# tried and reverted: that regressed even in the emulator (perfect DDR),
# stopping later, right after jump_to_copy()/relocate_code() reserve every
# region and just before the actual relocation copy -- so the SRAM address
# itself was not the (only) problem, and keeping it here is deliberate, not
# an oversight. On the board, moving it produced a boot trace that stopped
# at the exact same INITCALL boundary every time, with no error message and
# a silent full-core reset.
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0xbf00fe00
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SECT_SIZE=0x10000
CONFIG_DEFAULT_DEVICE_TREE="rtl8380-intelbras-sg1002-mr"
CONFIG_SYS_BOOTM_LEN=0x2000000
CONFIG_SYS_LOAD_ADDR=0x81000000
CONFIG_ARCH_RTL_OTTO=y
CONFIG_INTELBRAS_SG1002_MR_FACTORY_PAYLOAD=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_SYS_MIPS_TIMER_FREQ=200000000
CONFIG_BOOTDELAY=3
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_BOARD_POSTCLK_INIT=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_CYCLIC=y
CONFIG_SYS_PROMPT="RTL838x# "
# Version banner / Board / CPU / DRAM lines, called post-relocation from
# common/board_r.c instead of the normal board_f.c ones (see the comments
# around initcall_run_r() there for why).
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO_LATE=y
