ipaddr=192.168.1.199
serverip=192.168.1.10
gatewayip=192.168.1.254
netmask=255.255.255.0
bootdelay=2
initrd_high=0x0a000000
fdt_high=0x0a000000

/* Manual mainline bring-up over TFTP. Autoboot never runs this path. */
kernel_addr_r=0x08080000
fdt_addr_r=0x08008000
ramdisk_addr_r=0x13000000
tftp_kernel=Image
tftp_fdt=meson-gxlx-s905l-p271.dtb
tftp_ramdisk=android-initramfs.cpio.gz
tftp_bootargs=console=ttyAML0,115200n8 earlycon=meson,0xc81004c0 root=/dev/ram0 rdinit=/init androidboot.hardware=amlogic androidboot.selinux=permissive androidboot.debuggable=1 video=HDMI-A-1:1280x720@60e loglevel=7
boot_tftp=setenv bootargs ${tftp_bootargs}; if tftpboot ${kernel_addr_r} ${tftp_kernel} && tftpboot ${fdt_addr_r} ${tftp_fdt} && tftpboot ${ramdisk_addr_r} ${tftp_ramdisk}; then booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}; fi

/* Factory Android boot partition from the verified 7.3 GiB eMMC dump. */
/* P271's eMMC is mmc 2 in mainline U-Boot and requires single-block I/O. */
emmcdev=2
emmc_boot_lba=0x2ae000
emmc_boot_blocks=0x8000
emmc_bootimg_addr=0x20000000
emmc_kernel_addr=0x20000800
emmc_zimage_magic_addr=0x20000864
emmc_kernel_hcrc_addr=0x20000804
emmc_kernel_load_field_addr=0x20000810
emmc_kernel_entry_field_addr=0x20000814
emmc_ramdisk_addr=0x2096d800
emmc_ramdisk_size=0x16b0c7
emmc_second_addr=0x20ad9000
emmc_second_unpacked_addr=0x08000000
emmc_second_unpacked_size=0x39800
emmc_fdt_addr=0x08000800
factory_bootargs=rootfstype=ramfs init=/init console=ttyS0,115200 no_console_suspend earlyprintk=aml-uart,0xc81004c0 ramoops.pstore_en=1 ramoops.record_size=0x8000 ramoops.console_size=0x4000 use_cma_first=1 androidboot.selinux=permissive logo=osd0,loaded,0x3d800000,1080p60hz vout=1080p60hz,enable hdmimode=1080p60hz cvbsmode=576cvbs hdmitx=0 cvbsdrv=0 androidboot.firstboot=0 jtag=disable androidboot.hardware=amlogic androidboot.boardid=1 selinux=1 androidboot.dtbo_idx=0 buildvariant=userdebug
boot_emmc_original=echo 'Booting original Android from eMMC'; setenv bootargs ${factory_bootargs}; if mmc dev ${emmcdev} && mmc read ${emmc_bootimg_addr} ${emmc_boot_lba} ${emmc_boot_blocks}; then if itest.l *${emmc_bootimg_addr} == 0x52444e41 && itest.l *${emmc_kernel_addr} == 0x56190527 && itest.l *${emmc_zimage_magic_addr} == 0x016f2818; then if unzip ${emmc_second_addr} ${emmc_second_unpacked_addr} ${emmc_second_unpacked_size}; then if itest.l *${emmc_fdt_addr} == 0xedfe0dd0; then mw.l ${emmc_kernel_load_field_addr} 0x00000801; mw.l ${emmc_kernel_entry_field_addr} 0x00000801; mw.l ${emmc_kernel_hcrc_addr} 0xc7894e68; bootm ${emmc_kernel_addr} ${emmc_ramdisk_addr}:${emmc_ramdisk_size} ${emmc_fdt_addr}; else echo 'Invalid factory DTB magic'; fi; else echo 'Factory DTB bundle decompression failed'; fi; else echo 'Invalid factory Android/uImage/zImage magic'; fi; else echo 'Factory eMMC boot read failed'; fi
bootcmd=run boot_emmc_original
