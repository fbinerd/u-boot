/*
 * Default (compiled-in) environment of the Intelbras SG1002 MR, found through
 * CONFIG_SYS_BOARD (see doc/usage/environment.rst).  It becomes
 * default_environment[] in u-boot.bin and, through tools/build-sg1002-mr.sh,
 * the flashed env.bin, so the two cannot drift apart.  A factory-fresh or
 * erased board boots with exactly this, so it has to be complete on its own.
 *
 * It keeps the 23 vendor variables recovered from the factory dump, with two
 * corrections: ethaddr is the real factory MAC (SPI 0x141038), and baudrate
 * and bootdelay are not listed because CONFIG_BAUDRATE and CONFIG_BOOTDELAY
 * already emit them (115200 and 3).  bootcmd is absent on purpose:
 * board_late_init() sets it on every boot.
 *
 * boot_auto=1 recomputes bootcmd on every boot (0 keeps the saved one).
 * openwrt_addr is probed for the uImage magic 27 05 19 56 and booted if it is
 * there; otherwise vxworks_addr (the vendor bootrom) is.  Both point into the
 * memory-mapped SPI flash (offsets 0x150000 and 0x050000).  openwrt_addr uses
 * the cached KSEG0 alias of that window (0x94150000 instead of 0xb4150000):
 * bootm decompresses the LZMA kernel straight out of flash, which takes 7.6 s
 * cached against 23.8 s uncached.  Being cached, do a reset after an sf write
 * over 0x150000 before booting. With boot_auto=1, a missing or malformed
 * image address is reported and bootcmd is removed to prevent a stale saved
 * command from running. With boot_auto=0, a saved bootcmd is kept.
 *
 * led_test=1 runs the front-panel lamp test at the start of board_late_init()
 * (0 skips it silently, unset is reported and skipped, like boot_auto).
 * led_link_status=1 then shows one snapshot of each port's negotiated link:
 * no link = off, 10/100 = amber, 1000 = green (SFP links are 1000BASE-X).
 * 0 skips it silently; unset is reported and skipped.
 */

boardmodel=RTL8380M_INTPHY_2FIB_1G_DEMO
boardversion=0
boot_auto=1
bootargs=generic(0,0)host:vxWorks h=90.0.0.3 e=90.0.0.8 u=bdcom pw=switch
diagmode=4
ethact=rtl8380#0
ethaddr=D8:36:5F:90:D7:26
file_linux=vmlinux.bix
file_uboot=u-boot.bin
freemem=0x81000000
ipaddr=169.254.101.100
led_test=1
led_link_status=1
nuke_env=sf probe 0; sf erase $(flashoffset_env) +$(ssize_env)
openwrt_addr=0x94150000
postword=0
rtkon=rtk network on;ping $(serverip)
serverip=169.254.101.86
stderr=serial
stdin=serial
stdout=serial
up_linux=sf probe 0;sf read $(freemem) $(flashoffset_linux) $(ssize_linux);bootm $(freemem)
update_eprom=tftp 0x81000000 rom.bin;sf erase 0x50000 0x100000;sf write 0x81000000 0x50000 0x100000
update_linux=tftp $(freemem) $(file_linux);sf probe 0;sf erase $(flashoffset_linux) $(ssize_linux);sf write $(fileaddr) $(flashoffset_linux) $(ssize_linux)
update_uboot=tftp $(freemem) $(file_uboot);sf probe 0;sf erase $(flashoffset_uboot) $(ssize_uboot);sf write $(fileaddr) $(flashoffset_uboot) $(ssize_uboot)
vxworks_addr=0xb4050000
